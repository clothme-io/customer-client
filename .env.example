NEXT_PUBLIC_SITE_URL=https://clothme.app
NEXT_PUBLIC_GA_ID=G-8H7MC8EYN1
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_META_PIXEL_ID=1304223921590545
NEXT_PUBLIC_APP_ENV=development
# Set in production only.
NEXT_PUBLIC_POSTHOG_ALLOWED_HOSTS=clothme.io,www.clothme.io
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# Customer API (Shop / Discover / Cart web client). Base URL without /v1.
CUSTOMER_API_URL=https://dv-customer.api-clothme.com
# Local UI preview (default on in `next dev`). Set to 0 to use the live customer API.
# NEXT_PUBLIC_WEBCLIENT_MOCK=0

# Backend API (creator applications). BACKEND_API_URL is preferred for server-side routes.
# Use the base URL without /v1 — the app appends it automatically.
BACKEND_API_URL=https://your-backend-api.example.com
NEXT_PUBLIC_API_URL=https://your-backend-api.example.com

# Homepage sizing uses the customer/session and size-api settings below.

# Password for /admin/creators login (also sent as x-admin-key to the backend)
ADMIN_API_KEY=replace-with-a-long-random-secret

CLERK_SECRET_KEY=sk_test_xxxxx
ADMIN_EMAILS=you@example.com

DATABASE_URL=postgresql://user:password@host:port/database
# Use false for in-cluster Postgres (CNPG). Railway / public hosts usually need true.
DATABASE_SSL=true
# Set true only for migrate Jobs / one-shot sync — never on app Rollout pods.
RUN_MIGRATIONS=false
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_DB_PUSH=true

# Bunny Storage (Payload CMS media + webhook image ingest)
BUNNY_STORAGE_ZONE=clothme
BUNNY_STORAGE_REGION=
BUNNY_STORAGE_API_KEY=xxxxx
BUNNY_CDN_BASE_URL=https://clothme.b-cdn.net

# Optional email + webhook secrets
RESEND_API_KEY=
EMAIL_FROM=noreply@clothme.io
OUTRANK_WEBHOOK_SECRET=
BABYLOVEGROWTH_WEBHOOK_SECRET=

# Customer web commerce: explicit production URLs, no /v1 suffix.
CUSTOMER_API_URL=
SIZE_API_URL=
SIZE_API_TOKEN=
# Set explicitly to 0 in staging/production; 1 is only for local demonstrations.
NEXT_PUBLIC_WEBCLIENT_MOCK=0

# App download email: the placeholder guard still blocks sends until a real HTTPS URL is configured.
APP_DOWNLOAD_EMAIL_ENABLED=true
APP_DOWNLOAD_URL=https://example.com/clothme-download
EMAIL_LOGO_URL=https://clothme.io/email/clothme-logo.png

# Runtime analytics configuration from customer-client-web-secrets in Kubernetes.
# Only public ingestion identifiers are returned by /api/analytics-config.
MIXPANEL_TOKEN=
MIXPANEL_API_HOST=https://api-js.mixpanel.com
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_RELEASE=local
